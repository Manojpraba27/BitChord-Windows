{
  "name": "bitchord-desktop",
  "type": "module",
  "scripts": {
    "build": "tsc -p renderer && vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs && vitest run --passWithNoTests",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "pack": "npm run build && electron-builder --dir",
    "test:smoke": "node scripts/smoke.cjs"
  },
  "dependencies": {
    "music-metadata": "^11.10.3",
    "discord-rpc": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "electron": "45.3.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.0",
    "@playwright/test": "^1.56.1",
    "@bitchord/shared": "file:./shared",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-virtual": "^3.14.19",
    "@uimaxbai/am-lyrics": "^1.8.2",
    "bgutils-js": "^4.0.3",
    "essentia.js": "^0.1.3",
    "googlevideo": "^4.1.1",
    "hls.js": "~1.6.19",
    "idb": "^8.0.4",
    "lucide-react": "^1.57.0",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router": "^8.4.0",
    "shaka-player": "^4.16.52",
    "signalsmith-stretch": "^1.3.2",
    "youtubei.js": "^18.1.0",
    "zustand": "^5.0.15"
  },
  "version": "1.0.0",
  "description": "BitChord Music Player for Windows",
  "author": "BitChord contributors",
  "license": "AGPL-3.0-only",
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "in.bitchord.desktop",
    "productName": "BitChord",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "icon.png",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "BitChord-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "BitChord-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "BitChord-Portable.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kushagrasinghx/BitChord.git"
  }
}
